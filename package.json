{
	"name": "omp-spellbook",
	"version": "1.0.0",
	"description": "omp extension: type `? <description>` in the composer and get the shell command, morphed in as `!<command>`.",
	"keywords": [
		"omp",
		"omp-plugin",
		"oh-my-pi",
		"shell",
		"cli"
	],
	"license": "MIT",
	"author": "Dazzuh",
	"homepage": "https://github.com/Dazzuh/omp-spellbook#readme",
	"bugs": {
		"url": "https://github.com/Dazzuh/omp-spellbook/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Dazzuh/omp-spellbook.git"
	},
	"type": "module",
	"main": "./src/index.ts",
	"files": [
		"src",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"omp": {
		"name": "Spellbook",
		"description": "Describe a shell command after `?`, get the command in the composer as `!<command>`.",
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@oh-my-pi/pi-coding-agent": "18.20.2",
		"@types/bun": "^1.3.0",
		"typescript": "^5.9.0"
	},
	"engines": {
		"bun": ">=1.3.0"
	}
}
